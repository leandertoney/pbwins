# ==============================================================================
# pbWins Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development
# NEVER commit .env or .env.local to version control
# See STRIPE_SETUP.md for detailed configuration instructions
# ==============================================================================

# ------------------------------------------------------------------------------
# Convex Database
# ------------------------------------------------------------------------------
# Get this from: https://dashboard.convex.dev → Your Project → Settings
# Format: https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud

# ------------------------------------------------------------------------------
# Browserless (required for DUPR scraping)
# ------------------------------------------------------------------------------
# Get this from: https://browserless.io → Account → API Token
BROWSERLESS_TOKEN=your_browserless_token_here

# ------------------------------------------------------------------------------
# Stripe Payment Processing
# ------------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/test/apikeys
#
# For LOCAL development use TEST mode keys (pk_test_... and sk_test_...)
# For PRODUCTION use LIVE mode keys (pk_live_... and sk_live_...)
#
# IMPORTANT: Never commit your secret keys to git!

# Publishable Key (safe to expose in client-side code)
# Test mode: https://dashboard.stripe.com/test/apikeys
# Live mode: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret Key (KEEP THIS SECRET! Server-side only)
# Test mode: https://dashboard.stripe.com/test/apikeys
# Live mode: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook Signing Secret (for verifying webhook authenticity)
#
# For LOCAL development:
#   1. Install Stripe CLI: brew install stripe/stripe-cli/stripe
#   2. Run: stripe listen --forward-to localhost:3000/api/stripe/webhook
#   3. Copy the webhook signing secret from CLI output (whsec_...)
#
# For PRODUCTION:
#   1. Go to: https://dashboard.stripe.com/webhooks
#   2. Create endpoint: https://pbwins.com/api/stripe/webhook
#   3. Subscribe to events: checkout.session.completed, customer.subscription.deleted
#   4. Copy the signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
# Used for Stripe redirect URLs (success/cancel pages)
# Local: http://localhost:3000
# Production: https://pbwins.com (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Admin Panel Security
# ------------------------------------------------------------------------------
# Set this to a strong, unique password for admin access
# Use a password manager to generate a secure password
NEXT_PUBLIC_ADMIN_PASSWORD=your_secure_admin_password_here
